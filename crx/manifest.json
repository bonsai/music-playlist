{
  "manifest_version": 3,
  "name": "Radiooooo Playlist Sync",
  "version": "1.0.0",
  "description": "Radiooooo から曲を JSONL 保存 → WebSocket でプレイリスト更新",
  "permissions": [
    "activeTab",
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "*://*.radiooooo.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Radiooooo Playlist"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.radiooooo.com/*"],
      "js": ["content.js"]
    },
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["sidebar.js"]
    }
  ],
  "side_panel": {
    "path": "sidebar.html"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}