{
  "manifest_version": 3,
  "name": "Radiooooo → Last.fm Scrobbler",
  "version": "1.1.0",
  "description": "Now Playing と自動Scrobbleを Radiooooo から Last.fm へ送ります。",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://app.radiooooo.com/*",
    "https://*.last.fm/*",
    "https://ws.audioscrobbler.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://app.radiooooo.com/*"],
      "js": ["content-bridge.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://app.radiooooo.com/*"],
      "js": ["content-detector.js"],
      "world": "ISOLATED",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://*.last.fm/*"],
      "js": ["content-token.js"],
      "world": "ISOLATED",
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Radiooooo → Last.fm"
  }
}